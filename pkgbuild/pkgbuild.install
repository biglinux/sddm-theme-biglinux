## arg 1:  the new package version
post_install() {
	systemctl --global enable sddm-wallpaper.path
	# Each user's sddm-wallpaper.service copies their wallpaper over it.
	chmod 666 /usr/share/sddm/wallpaper/image.png

	# Generated by big-first-boot and the live session, with x11 after sddm-verify.
	# It would override sddm-theme-biglinux.conf and start maliit-keyboard, which
	# is not installed. Other content is the administrator's.
	wayland_config=/etc/sddm.conf.d/10-wayland.conf
	generated='[General]
DisplayServer=wayland
GreeterEnvironment=QT_WAYLAND_SHELL_INTEGRATION=layer-shell

[Wayland]
CompositorCommand=kwin_wayland --drm --no-lockscreen --no-global-shortcuts --locale1 --inputmethod maliit-keyboard'
	if [ -f "$wayland_config" ] &&
		[ "$(grep -v -e '^# Generated by big-first-boot;' -e '^# Generated by biglinux-livecd;' "$wayland_config" |
			sed 's/^DisplayServer=x11$/DisplayServer=wayland/')" = "$generated" ]; then
		rm -f "$wayland_config"
	fi
}

## arg 2:  the old package version
pre_upgrade() {
	# sddm-fix.service wanted sddm.service; drop its enablement while the unit exists.
	if [ -e /usr/lib/systemd/system/sddm-fix.service ]; then
		systemctl disable --no-reload sddm-fix.service
	fi
	# The X11 greeter's NumLock setting, written by sddm-fix.
	rm -f /etc/sddm.conf.d/enable_numlock.conf
}

## arg 2:  the old package version
post_upgrade() {
	post_install
}

